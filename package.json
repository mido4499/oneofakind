{
  "name": "oneofakind",
  "version": "0.1.0",
  "description": "Checks how unique a project name is across domains, package registries, GitHub and more. CLI and HTTP API.",
  "keywords": [
    "name",
    "naming",
    "project-name",
    "availability",
    "npm",
    "pypi",
    "domain",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mido4499/oneofakind.git"
  },
  "homepage": "https://mido4499.github.io/oneofakind/",
  "bugs": "https://github.com/mido4499/oneofakind/issues",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm test && npm run build",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "double-metaphone": "^2.0.1",
    "hono": "^4.13.13",
    "wordlist-english": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "oneofakind": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.9"
  }
}

{
  "name": "oneofakind",
  "version": "0.1.0",
  "description": "API that checks how unique a project name is across domains, package registries, GitHub and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mido4499/oneofakind.git"
  },
  "homepage": "https://github.com/mido4499/oneofakind#readme",
  "bugs": "https://github.com/mido4499/oneofakind/issues",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "double-metaphone": "^2.0.1",
    "hono": "^4.13.13",
    "wordlist-english": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "oneofakind": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.9"
  }
}

# Copy to .env and fill in. Every setting is optional; leave a value empty to keep the default.

# Port and bind address. 127.0.0.1 keeps the API reachable only through your reverse proxy.
PORT=3000
HOST=127.0.0.1

# GitHub token: raises search limits from 10 to 30 per minute, shared by every visitor.
# A fine-grained token with public read-only access is enough.
GITHUB_TOKEN=

# User-Agent sent to the registries. Wikidata and crates.io ask for contact details.
ONEOFAKIND_USER_AGENT=oneofakind (https://github.com/mido4499/oneofakind)

# Sites allowed to call the API from a browser: comma-separated origins, no trailing slash.
CORS_ORIGINS=https://mido4499.github.io

# Checks per minute per visitor IP. Empty means no limit.
RATE_LIMIT_PER_MINUTE=10

# 1 when running behind a reverse proxy that sets X-Forwarded-For, so the limit counts real visitors.
TRUST_PROXY=1
